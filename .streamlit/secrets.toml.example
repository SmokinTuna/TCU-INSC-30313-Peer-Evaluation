# ---------------------------------------------------------------------------
# EXAMPLE secrets file for the TCU Peer Evaluation app.
#
# DO NOT put real credentials in this file or commit them to GitHub.
# Local dev:  copy this to ".streamlit/secrets.toml" and fill in real values.
# Cloud:      paste the same contents into Streamlit Community Cloud →
#             App → Settings → Secrets (see README "Deploying to Streamlit
#             Community Cloud").
#
# If the [gcp_service_account] / [google_sheets] sections are omitted, the app
# falls back to LOCAL files (fine for offline testing, but NOT durable on
# Streamlit Cloud).
# ---------------------------------------------------------------------------

# Instructor login (unlocks Dashboard, Team View, Administration).
instructor_password = "change-me-instructor"

# Default student survey password. The instructor can override this in-app on
# the Administration page; that value (stored in the spreadsheet) wins.
student_password = "change-me-student"

# Google service account used to read/write the spreadsheet. Copy each field
# from the service-account JSON key you downloaded from Google Cloud.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
# Keep the literal \n escapes; TOML stores this as a single-line string.
private_key = "-----BEGIN PRIVATE KEY-----\nMIIB...your...key...\n-----END PRIVATE KEY-----\n"
client_email = "peer-eval@your-project-id.iam.gserviceaccount.com"
client_id = "1234567890"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/peer-eval%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

[google_sheets]
# Either the spreadsheet KEY (the long id in the URL) or the full URL works.
# Share the spreadsheet with the service-account client_email (Editor).
spreadsheet = "https://docs.google.com/spreadsheets/d/your-spreadsheet-id/edit"
